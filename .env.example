DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-this-to-a-random-secret-in-production"
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email notifications (contact form, Capital Access, admin alerts)
# Leave SMTP_HOST empty in local dev — emails are logged to the console
# For production Gmail delivery to CONTACT_EMAIL:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=sbdvault@gmail.com
#   SMTP_PASS=<Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SBDV <sbdvault@gmail.com>"
CONTACT_EMAIL=sbdvault@gmail.com
ADMIN_EMAIL=sbdvault@gmail.com

# Escrow account for Capital Access security deposits
ESCROW_BANK_NAME="SBDV Escrow — Zurich"
ESCROW_ACCOUNT_NAME="SBDV Capital Access Escrow Account"
ESCROW_IBAN="CH93 0076 2011 6238 5295 7"
ESCROW_SWIFT="SBDVCHZZ"

# Optional: Telegram notifications for membership/contact forms
TELEGRAM_CHAT_1_TOKEN=
TELEGRAM_CHAT_1_ID=

# Optional: AI concierge (falls back to rule-based answers without a key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

