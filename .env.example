# SBDV environment template — placeholders only. Never put real secrets here.
# Copy to `.env.local` (gitignored) for local development.
# Set the same keys in Vercel → Environment (and Namecheap DNS for your domain).

NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

AUTH_SECRET="generate-a-long-random-secret"
AUTH_TRUST_HOST=true
# Local:
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Admin host is derived as admin.localhost:3000 (add 127.0.0.1 admin.localhost to Windows hosts if needed).
# Production (Vercel + Namecheap sbdvault.com) — AUTH_URL must match the public site origin:
# AUTH_URL="https://www.sbdvault.com"
# NEXT_PUBLIC_SITE_URL="https://www.sbdvault.com"
# NEXT_PUBLIC_ADMIN_URL="https://admin.sbdvault.com"
# In Vercel Domains add www.sbdvault.com, sbdvault.com (redirect to www), and admin.sbdvault.com.
# *.vercel.app cannot host admin.{project}.vercel.app — admin stays at /en/admin there
# until those custom domains are attached.
# Seeded account holder (only this email can create staff admins):
# ACCOUNT_HOLDER_EMAIL="admin@sbdv.swiss"

# Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
EMAIL_FROM="SBDV <onboarding@resend.dev>"
CONTACT_EMAIL=info@sbdvault.com
ADMIN_EMAIL=ops@sbdvault.com
# QA only (Resend test sender): redirect all outbound mail to your Resend account inbox
# EMAIL_REDIRECT_TO=you@example.com
# Go-live: verify sbdvault.com in Resend, set EMAIL_FROM to SBDV <noreply@sbdvault.com>, remove EMAIL_REDIRECT_TO

# Optional Telegram mirrors for contact/membership forms
# TELEGRAM_CHAT_1_TOKEN=
# TELEGRAM_CHAT_1_ID=
# TELEGRAM_CHAT_2_TOKEN=
# TELEGRAM_CHAT_2_ID=

# Optional chatbot
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional writable uploads path (Vercel serverless has no persistent disk)
# DATA_DIR=/data

# Private-client wealth mandate (ops-confirmed funding; stated annual yield on principal)
# WEALTH_DEFAULT_YIELD_PCT=8
# 10% founding bonus on each of the first 1,000 funded clients' first confirmed deposit
# WEALTH_FOUNDING_BONUS_PCT=10
# WEALTH_FOUNDING_CLIENT_CAP=1000
# House wire/BTC coordinates are typed by ops on Approve (per notice), not from env.
