generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          String    @default("CLIENT")
  mfaSecret     String?
  mfaEnabled    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  clientProfile ClientProfile?
  accounts      Account[]
  sessions      Session[]
  auditEvents   AuditEvent[]
  messagesSent  Message[] @relation("SentMessages")
  messagesReceived Message[] @relation("ReceivedMessages")
  wealthDirectives WealthInvestmentDirective[]
  capitalAccessRequests CapitalAccessRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  tier      String   @default("standard")
  country   String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolios Portfolio[]
  documents  Document[]
}

model Portfolio {
  id              String   @id @default(cuid())
  clientProfileId String
  name            String   @default("Primary Portfolio")
  currency        String   @default("USD")
  asOfDate        DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  holdings      Holding[]
  performance   PerformanceRecord[]
}

model Holding {
  id            String   @id @default(cuid())
  portfolioId   String
  type          String
  name          String
  symbol        String?
  quantity      Float
  unit          String?
  costBasis     Float
  marketValue   Float
  purity        String?
  vaultLocation String?
  auditStatus   String   @default("verified")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model PerformanceRecord {
  id           String   @id @default(cuid())
  portfolioId  String
  period       String
  returnPct    Float
  benchmarkPct Float?
  recordedAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
}

model Document {
  id              String   @id @default(cuid())
  clientProfileId String
  name            String
  type            String   @default("OTHER")
  filePath        String
  fileSize        Int?
  uploadedAt      DateTime @default(now())

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  subject    String
  body       String
  encrypted  Boolean  @default(true)
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
}

model MembershipApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  country    String
  assetRange String
  message    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GlobalWealthEntity {
  id              String   @id @default(cuid())
  category        String
  country         String
  region          String?
  name            String
  vehicleName     String?
  aumMinUsd       Float
  aumMaxUsd       Float
  displayFraction Float    @default(0.08)
  mandate         String
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  directives WealthInvestmentDirective[]
  capitalRequests CapitalAccessRequest[]
}

model WealthInvestmentDirective {
  id          String   @id @default(cuid())
  entityId    String
  createdById String
  amountUsdM  Float
  assetClass  String
  directive   String
  status      String   @default("PENDING")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity    GlobalWealthEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model CapitalAccessRequest {
  id                   String   @id @default(cuid())
  userId               String
  poolId               String
  companyName          String
  companyRegistration  String
  country              String
  industry             String
  investmentAreas      String
  financialsSummary    String
  annualRevenueUsd     Float
  requestedAmountUsd   Float
  termYears            Int
  repaymentFrequency   String
  interestRatePct      Float
  securityDepositPct   Float    @default(10)
  securityDepositUsd   Float
  totalInterestUsd     Float
  installmentUsd       Float
  termsAccepted        Boolean  @default(false)
  status               String   @default("PENDING")
  onboardingPhase      String?
  escrowBankName       String?
  escrowBankAddress    String?
  escrowAccountName    String?
  escrowAccountNumber  String?
  escrowIban           String?
  escrowSwift          String?
  escrowBeneficiary    String?
  escrowBeneficiaryAddress String?
  escrowPaymentRef     String?
  depositReference     String?
  depositSubmittedAt   DateTime?
  depositConfirmedAt   DateTime?
  kycCompletedAt       DateTime?
  disbursedAt          DateTime?
  relationshipManager  String?
  adminNotes           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool      GlobalWealthEntity        @relation(fields: [poolId], references: [id], onDelete: Cascade)
  documents CapitalAccessDocument[]
}

model CapitalAccessDocument {
  id         String   @id @default(cuid())
  requestId  String
  name       String
  type       String
  filePath   String
  fileSize   Int?
  uploadedAt DateTime @default(now())

  request CapitalAccessRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}
